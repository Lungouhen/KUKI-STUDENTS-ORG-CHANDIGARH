APP_NAME="KSO Chandigarh"

# Use "local" only on a developer machine. Production MUST be "production"
# with APP_DEBUG=false, otherwise stack traces are exposed publicly.
APP_ENV=local
APP_DEBUG=true

# Leave blank and run: php artisan key:generate
# Must base64-decode to exactly 32 bytes for AES-256-CBC.
APP_KEY=

APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# SQLite by default. For MySQL set DB_CONNECTION=mysql and the credentials below.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=kso_chandigarh
# DB_USERNAME=
# DB_PASSWORD=

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS="ksochandigarh@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# Seeded administrator account. Set these before running `php artisan db:seed`
# in any shared or production environment.
ADMIN_EMAIL=admin@ksochandigarh.org
ADMIN_PASSWORD=

# Payment gateway (Razorpay). Leave blank to keep donations in offline/UPI mode.
RAZORPAY_KEY=
RAZORPAY_SECRET=
